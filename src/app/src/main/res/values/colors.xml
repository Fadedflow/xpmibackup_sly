<?xml version="1.0" encoding="utf-8"?>
<!--
  小米（HyperOS）色彩体系 —— 浅色
  ─────────────────────────────────────────────────────────────
  依据 skills/xiaomi-uiux-guidelines/references/color.md：
   · 品牌色 #FF6900（Blaze Orange），只做点缀：主 CTA、选中态、关键强调
   · 层级靠「同一支色的不透明度」而非堆灰阶（单色透明阶 3/6/8/10/20/55/60%）
   · 深色模式对称翻转黑白两支，见 values-night/colors.xml
  可访问性：正文/次要/辅助文字对页面底与卡片底均满足 WCAG 2.1 AA（≥4.5:1），
  官方色彩的 40% 档在浅色下仅 ~2.8:1，故浅色下辅助层级提升到 55%（见 docs/UI-DESIGN.md）。
-->
<resources>
    <!-- ========== 品牌 ========== -->
    <color name="brand">#FF6900</color>
    <color name="brand_pressed">#E05A00</color>
    <color name="brand_container">#1FFF6900</color>
    <color name="brand_container_pressed">#33FF6900</color>
    <color name="on_brand">#FFFFFF</color>

    <!-- ========== 兼容别名（旧引用，语义等价于品牌主色） ========== -->
    <color name="primary">#FF6900</color>
    <color name="primary_dark">#E05A00</color>
    <color name="primary_light">#F0F0F0</color>
    <color name="primary_text_on">#FFFFFF</color>

    <!-- ========== 页面与表面（单色透明阶） ========== -->
    <color name="background">#F5F5F5</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F2F2F2</color>
    <color name="input_bg">#F2F2F2</color>
    <color name="surface_pressed">#E8E8E8</color>
    <color name="card_border">#14000000</color>
    <color name="divider">#14000000</color>
    <color name="outline">#26000000</color>
    <color name="status_bar">#F5F5F5</color>

    <!-- 悬浮底栏与浮层 -->
    <color name="floating_bar">#FFFFFF</color>
    <color name="floating_bar_border">#14000000</color>
    <color name="scrim">#66000000</color>
    <color name="ripple">#14000000</color>
    <color name="ripple_on_brand">#33FFFFFF</color>

    <!-- ========== 文字层级 ========== -->
    <color name="text_primary">#171717</color>
    <color name="text_secondary">#666666</color>
    <color name="text_tertiary">#737373</color>
    <color name="text_hint">#737373</color>
    <color name="text_disabled">#A3A3A3</color>
    <color name="text_on_brand">#FFFFFF</color>

    <!-- ========== Tab / 图标底板 ========== -->
    <color name="tab_selected_bg">#1FFF6900</color>
    <color name="icon_tile">#F2F2F2</color>
    <color name="icon_on_tile">#666666</color>

    <!-- ========== 语义色（功能色，独立于品牌强调色） ========== -->
    <color name="danger">#D93025</color>
    <color name="danger_pressed">#B3261E</color>
    <color name="danger_container">#1FD93025</color>
    <color name="success">#188038</color>
    <color name="warning">#B26500</color>
</resources>
