<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮底栏容器：中性表面 + 24dp 圆角 + 1px 内描边；投影由 elevation 统一投射 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/floating_bar" />
            <corners android:radius="@dimen/radius_bar" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/floating_bar_border" />
            <corners android:radius="@dimen/radius_bar" />
        </shape>
    </item>
</layer-list>
