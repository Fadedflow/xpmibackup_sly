<?xml version="1.0" encoding="utf-8"?>
<!--
  小米（HyperOS）色彩体系 —— 深色（强制适配，官方规范）
  ─────────────────────────────────────────────────────────────
  对称翻转：浅色里「黑」做表面、「白」做墨；深色里两支对调。
  底色用 #0A0A0A 而非纯黑、正文用 #EDEDED 而非纯白（避免光晕感，官方实测值）。
  所有文字层级对底色对比度 ≥ 4.5:1，满足 WCAG 2.1 AA。
-->
<resources>
    <!-- ========== 品牌（深色下保持品牌色不变，对 #0A0A0A 对比度 6.3:1） ========== -->
    <color name="brand">#FF6900</color>
    <color name="brand_pressed">#FF8533</color>
    <color name="brand_container">#33FF6900</color>
    <color name="brand_container_pressed">#4DFF6900</color>
    <color name="on_brand">#FFFFFF</color>

    <!-- ========== 兼容别名 ========== -->
    <color name="primary">#FF6900</color>
    <color name="primary_dark">#FF8533</color>
    <color name="primary_light">#242424</color>
    <color name="primary_text_on">#FFFFFF</color>

    <!-- ========== 页面与表面 ========== -->
    <color name="background">#0A0A0A</color>
    <color name="surface">#171717</color>
    <color name="surface_variant">#242424</color>
    <color name="input_bg">#242424</color>
    <color name="surface_pressed">#2E2E2E</color>
    <color name="card_border">#1FFFFFFF</color>
    <color name="divider">#1FFFFFFF</color>
    <color name="outline">#33FFFFFF</color>
    <color name="status_bar">#0A0A0A</color>

    <!-- 悬浮底栏与浮层 -->
    <color name="floating_bar">#1F1F1F</color>
    <color name="floating_bar_border">#1FFFFFFF</color>
    <color name="scrim">#99000000</color>
    <color name="ripple">#24FFFFFF</color>
    <color name="ripple_on_brand">#40FFFFFF</color>

    <!-- ========== 文字层级 ========== -->
    <color name="text_primary">#EDEDED</color>
    <color name="text_secondary">#A8A8A8</color>
    <color name="text_tertiary">#999999</color>
    <color name="text_hint">#999999</color>
    <color name="text_disabled">#5C5C5C</color>
    <color name="text_on_brand">#FFFFFF</color>

    <!-- ========== Tab / 图标底板 ========== -->
    <color name="tab_selected_bg">#33FF6900</color>
    <color name="icon_tile">#242424</color>
    <color name="icon_on_tile">#A8A8A8</color>

    <!-- ========== 语义色 ========== -->
    <color name="danger">#F28B82</color>
    <color name="danger_pressed">#F6A9A1</color>
    <color name="danger_container">#33F28B82</color>
    <color name="success">#6DD58C</color>
    <color name="warning">#FFB400</color>
</resources>
